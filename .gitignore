# dependencies
node_modules/

# build output
dist/
dev-dist/
.vite/

# cloudflare
.wrangler/

# tests & coverage
coverage/
playwright-report/
test-results/

# env & secrets
.env
.env.*
*.pem

# logs
*.log
debug.log

# os junk
.DS_Store
Thumbs.db
desktop.ini

# editor
.idea/
.vscode/
*.swp

# superpowers sdd scratch
.superpowers/

# android (capacitor) build outputs — generated android/.gitignore covers most;
# these pin the release/keystore paths it leaves open
android/.gradle/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
android/key.properties
android/*.keystore
android/*.jks

# defense-in-depth: keystores anywhere under android/
android/**/*.jks
android/**/*.keystore

# beta tester invites — real email addresses, git-ignored by design.
# The directory pattern (docs/invites/) cannot be re-included per-file, so
# the contents are ignored and only the redacted template is let back in:
# check with `git check-ignore docs/invites/invite-TESTIS.md` (ignored) and
# `git check-ignore docs/invites/TEMPLATE.example.md` (not ignored).
docs/invites/*
!docs/invites/TEMPLATE.example.md

# probe screenshots / scratch from debugging sessions
.tmp/
