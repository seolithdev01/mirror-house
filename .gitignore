# android (capacitor) build outputs — generated android/.gitignore covers most;
# these pin the release/keystore paths it leaves open
android/.gradle/
android/app/build/
android/app/release/
android/local.properties
android/.idea/
android/key.properties
android/*.keystore
android/*.jks

# defense-in-depth: keystores anywhere under android/
android/**/*.jks
android/**/*.keystore
